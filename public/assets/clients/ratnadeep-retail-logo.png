  display: flex;
  align-items: center;
}
#uc_fullscreen_navigation_menu_elementor_42c612d ul:not(#uc_fullscreen_navigation_menu_elementor_42c612d section ul) {
  list-style: none;
  margin: 0;
  display: block;
  padding:0px;
}
#uc_fullscreen_navigation_menu_elementor_42c612d .ue_menu  div  div  ul li {
  padding: 0;
