<style>/* widget: Fullscreen Menu */

.elementor-sticky{
	overflow: visible !important;
}

	


#uc_fullscreen_navigation_menu_elementor_42c612d * {
  box-sizing: border-box;
}
#uc_fullscreen_navigation_menu_elementor_42c612d a,
#uc_fullscreen_navigation_menu_elementor_42c612d a:visited,
#uc_fullscreen_navigation_menu_elementor_42c612d a:hover,
#uc_fullscreen_navigation_menu_elementor_42c612d a:active {
  text-decoration: none;
}


#uc_fullscreen_navigation_menu_elementor_42c612d .ue-input-wrapper{
  position:relative;  
}

#uc_fullscreen_navigation_menu_elementor_42c612d .ue-input-wrapper-align{
  display:flex;
}

#uc_fullscreen_navigation_menu_elementor_42c612d .ue_hamburger *{
  transition: all 200ms;
}

#uc_fullscreen_navigation_menu_elementor_42c612d .ue_hamburger_custom_open svg{
  height:1em;
  width:1em;
}

#uc_fullscreen_navigation_menu_elementor_42c612d .ue_hamburger_custom_close svg{
  height:1em;
  width:1em;
}

#uc_fullscreen_navigation_menu_elementor_42c612d .uc_hamburger{
  display: inline-block;  
}

#uc_fullscreen_navigation_menu_elementor_42c612d .uc_line{
  transition: all .3s;
}

#uc_fullscreen_navigation_menu_elementor_42c612d{
  position:relative;
  z-index:99998;
}

#uc_fullscreen_navigation_menu_elementor_42c612d .checkbox-toggle {
  position: absolute;
  z-index: 100000000;
  cursor: pointer;
  opacity: 0;
  top:0px;
}

#uc_fullscreen_navigation_menu_elementor_42c612d .checkbox-toggle:checked + .ue_hamburger > div:after {
  opacity: 0;
}

#uc_fullscreen_navigation_menu_elementor_42c612d.menu-opened .ue_menu {
  pointer-events: auto;
}

#uc_fullscreen_navigation_menu_elementor_42c612d.menu-opened .ue_menu > div.ue_inner_menu {
      visibility: visible;
  -webkit-transition-duration: 0.75s;
          transition-duration: 0.75s;
}

#uc_fullscreen_navigation_menu_elementor_42c612d.menu-opened .ue_menu > div.ue_inner_menu > div > div {
  opacity: 1;
  transition: opacity 0.4s ease 0.4s;
}

/* start open transition animations */
	

#uc_fullscreen_navigation_menu_elementor_42c612d .ue_menu .ue_inner_menu {
transform: translate(-100%, 0);
}

#uc_fullscreen_navigation_menu_elementor_42c612d.menu-opened .ue_menu > div.ue_inner_menu {
  -webkit-transform: translate(0, 0);
          transform: translate(0, 0);
}
	

	

	

	

	

	

	

	
/* end open transition animations */

#uc_fullscreen_navigation_menu_elementor_42c612d .ue_hamburger {
  top: 0;
  cursor: pointer;
  transition: 0.4s;
  backface-visibility: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  position:absolute;
  z-index:99999999;
}


      #uc_fullscreen_navigation_menu_elementor_42c612d .checkbox-toggle:checked + .ue_hamburger > div {
              transform: rotate(135deg);
    }
    #uc_fullscreen_navigation_menu_elementor_42c612d .checkbox-toggle:checked + .ue_hamburger > div:before,
    #uc_fullscreen_navigation_menu_elementor_42c612d .checkbox-toggle:checked + .ue_hamburger > div:after {
      top: 0;
      -webkit-transform: rotate(90deg);
              transform: rotate(90deg);
    }
    #uc_fullscreen_navigation_menu_elementor_42c612d .checkbox-toggle:checked:hover + .ue_hamburger > div {
              transform: rotate(225deg);
    }
    #uc_fullscreen_navigation_menu_elementor_42c612d .ue_hamburger > div {
      position: relative;
      -webkit-box-flex: 0;
              flex: none;
      width: 100%;
      height: 2px;
      transition: all 0.4s ease;
      display: flex;
              align-items: center;
              justify-content: center;
      background-color:#2E3192;
    }

    #uc_fullscreen_navigation_menu_elementor_42c612d .checkbox-toggle:checked + .ue_hamburger > div {
              color:#2E3192;
              background-color:;
    }

    #uc_fullscreen_navigation_menu_elementor_42c612d input:hover + .ue_hamburger > div{
      background-color:#2E3192;
    }

    #uc_fullscreen_navigation_menu_elementor_42c612d .ue_hamburger > div:before,
    #uc_fullscreen_navigation_menu_elementor_42c612d .ue_hamburger > div:after {
      content: '';
      position: absolute;
      z-index: 1;
      top: -10px;
      left: 0;
      width: 100%;
      height: 2px;
      background: inherit;
    }

    #uc_fullscreen_navigation_menu_elementor_42c612d .ue_hamburger > div:after {
      top: 10px;
    }
  /* end effects == "def" */



#uc_fullscreen_navigation_menu_elementor_42c612d .ue_menu {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  pointer-events: none;
  visibility: hidden;       
  backface-visibility: hidden;
  outline: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* start protection from doubled fixed section in elementor */
.uc-hidden #uc_fullscreen_navigation_menu_elementor_42c612d .ue_menu{
   opacity: 0;
   pointer-events: none;
}
.uc-visible #uc_fullscreen_navigation_menu_elementor_42c612d .ue_menu{
   opacity: 1;
   pointer-events: all;
}
/* end protection from doubled fixed section in elementor */

#uc_fullscreen_navigation_menu_elementor_42c612d .ue_menu .ue_inner_menu {
  color: #fff;
  transition: all 0.4s ease;
  height: 100vh;
  overflow-y: auto;
  overflow-x: hidden;
  display: flex;
}
#uc_fullscreen_navigation_menu_elementor_42c612d .ue_inner_menu-box{
