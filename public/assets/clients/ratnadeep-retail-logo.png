#uc_fullscreen_navigation_menu_elementor_42c612d .ue_menu  div  div  ul  li a:hover:after {
  width: 100%;
}
#uc_fullscreen_navigation_menu_elementor_42c612d .ue_menu  div  div  ul  li  a:after {
  content: '';
  position: absolute;
  z-index: 1;
  bottom: 0;
  left: 0;
  width: 0;
  height: 2px;
  transition: width 0.4s ease;
}

	

.ue_menu_wrapper{
  position:relative;
}



#uc_fullscreen_navigation_menu_elementor_42c612d .ue_menu-social-icons a{
