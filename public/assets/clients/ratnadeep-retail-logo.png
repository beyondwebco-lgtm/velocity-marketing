<style>/* widget: WordPress Menu */

/* reset defaults */
dd, dl, dt, li, ol, ul{
  border: unset;
  padding: unset;
  background: unset;
}
/* end reset defaults */

#uc_nav_menu_elementor_a6b627c{
	position: relative;
}

#uc_nav_menu_elementor_a6b627c .ue-nav-menu-mobile-wrapper{
 	display: flex;
}

#uc_nav_menu_elementor_a6b627c .ue-menu{
    display:flex;
    list-style:none;
    margin:0;
    position:relative;
  	justify-content:space-between;
}

#uc_nav_menu_elementor_a6b627c a{
  	position: relative;
	text-decoration: none;
 	display: flex;
  	align-items: center;  
}


	






#uc_nav_menu_elementor_a6b627c .ue-menu > li {
	display: block;
  	       flex-shrink: 1;
   	   min-width: 0;
  	}

/* Simple multilevel dropdown */
#uc_nav_menu_elementor_a6b627c .ue-menu > li > .sub-menu {
	opacity: 0;
	visibility: hidden;
	position: absolute;
	list-style: none;
	text-align: inherit;
    display:block;
	z-index: 99;
}

/* First level appear */
#uc_nav_menu_elementor_a6b627c .ue-menu > li:hover > .sub-menu{
	opacity: 1;
	visibility: visible;
}

#uc_nav_menu_elementor_a6b627c .ue-menu > li.uc-active > .sub-menu {
	opacity: 1;
	visibility: visible;
}

/* Style for dropdown links */
#uc_nav_menu_elementor_a6b627c .ue-menu li > .sub-menu li {
	position: relative;
	display: block;
}

/* Second and third dropdown level */
#uc_nav_menu_elementor_a6b627c .ue-menu > li > .sub-menu li{
  display: block;
}

#uc_nav_menu_elementor_a6b627c .ue-menu > li > .sub-menu > li .sub-menu {
	opacity: 0;
	visibility: hidden;
	position: absolute;
	list-style: none;
	top:0px;
  	z-index: 100;
}

/* Second and third level appears */
#uc_nav_menu_elementor_a6b627c .ue-menu > li .sub-menu li:hover > .sub-menu {
	opacity: 1;
	visibility: visible;
}

#uc_nav_menu_elementor_a6b627c .ue-menu > li .sub-menu li.uc-active > .sub-menu {
	opacity: 1;
	visibility: visible;
}

#uc_nav_menu_elementor_a6b627c li,
#uc_nav_menu_elementor_a6b627c a{
	transition: all 0.3s ease-in-out;
}

#uc_nav_menu_elementor_a6b627c ul{
	transition: all 0.3s ease-in-out;
}

#uc_nav_menu_elementor_a6b627c .ue-nav-menu-checkbox{ 
  	display: none; 
}

#uc_nav_menu_elementor_a6b627c .ue-nav-menu-mobile{
  	display: none;
	transition: all .3s;
    cursor: pointer;
}

#uc_nav_menu_elementor_a6b627c .ue-nav-menu-icon,
#uc_nav_menu_elementor_a6b627c .ue-back-link-icon{
	display: flex;
    transition: all .3s ease;
}

#uc_nav_menu_elementor_a6b627c .ue-nav-menu-icon i {
  pointer-events: none;
}

#uc_nav_menu_elementor_a6b627c .ue-back-link{
  display: none !important;
}

#uc_nav_menu_elementor_a6b627c .uc-close-side-menu{
  display: none;
  transition: all .3s ease;
}

#uc_nav_menu_elementor_a6b627c .ue-nav-menu-mobile > *{
	display: none;
  	justify-content: center;
  	align-items: center;
}
#uc_nav_menu_elementor_a6b627c .ue-nav-menu-mobile > .uc-active{
	display: flex;
}

/* hover effects */

/*Effect 3*/
